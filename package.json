{
  "name": "skytest",
  "version": "0.1.0",
  "description": "Playwright Chat Runner – SkyTest (Issue #1 skeleton)",
  "main": "dist/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:main\" \"wait-on http://localhost:3000 && electron .\"",
    "dev:renderer": "webpack serve --config webpack.renderer.config.js --mode development",
    "dev:main": "webpack --config webpack.main.config.js --mode development --watch",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "webpack --config webpack.main.config.js --mode production",
    "build:renderer": "webpack --config webpack.renderer.config.js --mode production",
    "build:ci": "webpack --config webpack.ci.config.js --mode production",
    "ci:run": "node dist/ci/ci-runner.js",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "keywords": [
    "electron",
    "playwright",
    "testing"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "concurrently": "^8.0.0",
    "css-loader": "^6.0.0",
    "electron": "^35.7.5",
    "html-webpack-plugin": "^5.0.0",
    "jest": "^30.2.0",
    "style-loader": "^3.0.0",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.0.0",
    "typescript": "^5.0.0",
    "wait-on": "^7.0.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0",
    "webpack-dev-server": "^5.2.3"
  },
  "dependencies": {
    "playwright": "^1.58.2",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/app"
    ],
    "testMatch": [
      "**/*.test.ts"
    ]
  }
}
